// Cloudflare Worker config. No secrets here: they come from .dev.vars locally
// (made by `make backend-dev`) and from `make secrets` in production.
{
  // The Worker's name, which is also the start of its address: app.shakeawake.workers.dev.
  // It must match the name in the Cloudflare dashboard, or a deploy creates a second Worker.
  "name": "app",
  "main": "src/entry.py",
  "compatibility_date": "2026-11-19",
  "compatibility_flags": ["python_workers"],
  "assets": {
    // The built website. Static files are served directly, without running Python;
    // only /api/* runs the Worker.
    "directory": "../web/dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  // The settings saved from the website (calendar link, lead time, alarm type, auto-off), so the
  // nightly sync can use them. The id isn't a secret. `make backend-dev` uses a local copy.
  "kv_namespaces": [{ "binding": "SETTINGS", "id": "b24b631825a041099420ac7b47be588e" }],
  // Every hour on the hour; the Worker syncs the calendar only in the hour chosen in Settings
  // (3 am New York time unless changed). A cron can't be changed without a deploy, hence hourly.
  "triggers": { "crons": ["0 * * * *"] },
  "observability": { "enabled": true }   // Workers Logs: shows each request's CPU time
}
