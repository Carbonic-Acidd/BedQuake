# Copy this file to firmware/.env and fill in your values.
# firmware/.env is git-ignored; never commit real credentials.
# The deploy script copies it to the Pico as /.env.

# Wi-Fi network name (2.4 GHz, WPA/WPA2-Personal).
WIFI_SSID=

# Wi-Fi password.
WIFI_PASSWORD=

# MQTT broker hostname, e.g. your HiveMQ Cloud cluster address.
MQTT_HOST=

# MQTT username for this Pico.
MQTT_USER=

# MQTT password for this Pico.
MQTT_PASSWORD=

# Unique name for this BedQuake unit, used in topics as bedquake/<DEVICE_ID>/.
DEVICE_ID=
