# --- Pico ---
WIFI_SSID=
WIFI_PASSWORD=
PICO_MQTT_USER=
PICO_MQTT_PASS=
MQTT_HOST=your-id.ala.us-east-1.emqxsl.com
MQTT_PORT=8883

# --- Backend (Cloudflare Worker). `make secrets` uploads these; `make backend-dev` uses them locally ---
# Calendar's private iCal (.ics) address. Google Calendar: Settings > your calendar >
# "Secret address in iCal format". webcal:// links work too.
ICS_URL=
# EMQX console > deployment Overview > REST API, e.g. https://your-id.ala.us-east-1.emqxsl.com:8443/api/v5
EMQX_API_URL=
# EMQX console > deployment Overview > Deployment API Key (App ID and App Secret)
EMQX_API_KEY=
EMQX_API_SECRET=
# Minutes before the day's first calendar event that the alarm goes off (default 60)
ALARM_OFFSET_MIN=60
# Names this Pico in the MQTT topics: shakeawake/<DEVICE_ID>/... (used by the Pico and the Worker)
DEVICE_ID=bed1
# The website's shared password (long passphrase, e.g. four or five random words).
# Typed into the page once per device; the Worker rejects /api calls without it.
APP_PASSWORD=
